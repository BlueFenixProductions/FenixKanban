# Live Fizzy API credentials for the integration harness (fizzyctl + Live* test suites).
# Copy to .env (git-ignored) and fill in. Live suites self-skip when unset.
#
# FIZZY_TOKEN:  personal access token (Fizzy web UI -> settings)
# FIZZY_ACCOUNT: account slug, digits only, no leading slash (e.g. 897362094)
FIZZY_TOKEN=
FIZZY_ACCOUNT=
FIZZY_BASE_URL=https://fizzy.bluefenix.net

# Live-test knobs
FIZZY_EXPECTED_CARDS=32
# Mutation suites (sacrificial [itest]-prefixed cards only) stay off unless explicitly enabled.
FIZZY_ALLOW_MUTATION=0
